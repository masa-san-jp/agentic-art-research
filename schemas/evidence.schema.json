{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agentic-art-research/evidence.schema.json",
  "title": "Evidence",
  "type": "object",
  "required": ["id", "source_type", "source_location", "acquired_at", "content_hash", "rights_status", "sensitivity", "redistribution", "related_questions", "extraction_status", "direct_observation", "observed_by"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^EV[0-9]{3,}$"},
    "source_type": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
    "source_location": {"$ref": "common.schema.json#/$defs/uri"},
    "creator": {"type": ["string", "null"], "minLength": 1},
    "created_at": {
      "anyOf": [
        {"$ref": "common.schema.json#/$defs/timestamp"},
        {"const": "unknown"},
        {"type": "null"}
      ]
    },
    "acquired_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "content_hash": {"$ref": "common.schema.json#/$defs/sha256"},
    "rights_status": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
    "sensitivity": {"$ref": "common.schema.json#/$defs/accessClass"},
    "redistribution": {"enum": ["allowed", "prohibited", "conditional", "unknown"]},
    "related_projects": {
      "type": "array",
      "items": {"$ref": "common.schema.json#/$defs/projectId"},
      "uniqueItems": true
    },
    "related_questions": {
      "type": "array",
      "items": {"type": "string", "pattern": "^Q[0-9]{3,}$"},
      "uniqueItems": true
    },
    "extraction_status": {"enum": ["unprocessed", "processed", "excluded"]},
    "direct_observation": {"type": "boolean"},
    "observed_by": {"type": ["string", "null"], "minLength": 1}
  }
}
