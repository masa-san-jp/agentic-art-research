{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agentic-art-research/common.schema.json",
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "stableId": {
      "type": "string",
      "pattern": "^[A-Z]{2,4}[0-9]{3,}$"
    },
    "projectId": {
      "type": "string",
      "pattern": "^project/[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "uri": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "accessClass": {
      "enum": ["PRIVATE_RAW", "PRIVATE_DERIVED", "PROJECT_INTERNAL", "PUBLIC_CITABLE", "RESTRICTED"]
    },
    "projectStatus": {
      "enum": ["DRAFT", "PLANNED", "COLLECTING", "NORMALIZING", "ANALYZING", "DECIDING", "READY_FOR_PRODUCTION", "VALIDATING", "COMPLETE", "COMPLETE_WITH_GAPS", "BLOCKED", "CANCELLED"]
    },
    "claimType": {
      "enum": ["FACT", "SOURCE_CLAIM", "OBSERVATION", "INTERPRETATION", "INFERENCE", "PREFERENCE_SIGNAL", "HYPOTHESIS"]
    },
    "epistemicStatus": {
      "enum": ["VERIFIED", "SUPPORTED", "CONTESTED", "WEAK", "HYPOTHESIS", "REJECTED", "UNRESOLVED"]
    },
    "decisionStatus": {
      "enum": ["PROPOSED", "ADOPTED", "REJECTED", "ON_HOLD", "INVALIDATED"]
    },
    "requirementPriority": {
      "enum": ["mandatory", "preferred", "optional"]
    },
    "confidenceFactor": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    },
    "conflictPenalty": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2
    },
    "taskStatus": {
      "enum": ["PENDING", "RUNNING", "SUCCEEDED", "FAILED", "BLOCKED"]
    },
    "taskFailureClass": {
      "enum": ["TRANSIENT", "TIMEOUT", "RATE_LIMIT", "LEASE_EXPIRED", "PERMANENT", "VALIDATION", "AUTHORIZATION", "DEPENDENCY_FAILED"]
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "gitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "workflowMode": {
      "enum": ["RESEARCH_ONLY", "PRODUCTION_HANDOFF"]
    },
    "costBand": {
      "enum": ["LOW", "MEDIUM", "HIGH", "UNKNOWN"]
    },
    "durationBand": {
      "enum": ["HOURS", "DAYS", "WEEKS", "MONTHS", "UNKNOWN"]
    },
    "dependencyLevel": {
      "enum": ["NONE", "LOW", "MEDIUM", "HIGH", "UNKNOWN"]
    },
    "reviewStatus": {
      "enum": ["CLEAR", "REVIEW_REQUIRED", "BLOCKED", "UNKNOWN"]
    },
    "hypothesisRecommendation": {
      "enum": ["RECOMMENDED", "ALTERNATIVE", "REJECTED", "ON_HOLD"]
    },
    "uncertaintySeverity": {
      "enum": ["MINOR", "MAJOR", "CRITICAL"]
    },
    "prototypeStatus": {
      "enum": ["PLANNED", "READY", "EXTERNAL_VALIDATION_REQUIRED", "COMPLETED", "FAILED", "BLOCKED", "CANCELLED"]
    },
    "handoffSelectionStatus": {
      "enum": ["AGENT_RECOMMENDED", "HUMAN_SELECTED", "HUMAN_SELECTION_REQUIRED"]
    },
    "selectionAuthority": {
      "enum": ["agent-recommended", "human-approved", "policy-derived"]
    },
    "handoffStatus": {
      "enum": ["DRAFT", "READY", "ACCEPTED", "REJECTED", "SUPERSEDED", "CANCELLED"]
    }
  }
}
