{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agentic-art-research/research-request.schema.json",
  "title": "Upstream research request",
  "type": "object",
  "required": [
    "schema_version",
    "request_id",
    "requested_at",
    "source",
    "project",
    "intent",
    "constraints",
    "references",
    "open_questions",
    "data_boundary"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "request_id": {"type": "string", "pattern": "^RR[0-9]{3,}$"},
    "requested_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "source": {"$ref": "#/$defs/source"},
    "project": {"$ref": "#/$defs/project"},
    "intent": {"$ref": "#/$defs/intent"},
    "constraints": {"$ref": "#/$defs/constraints"},
    "references": {
      "type": "array",
      "items": {"$ref": "#/$defs/reference"}
    },
    "open_questions": {
      "type": "array",
      "items": {"$ref": "common.schema.json#/$defs/nonEmptyString"}
    },
    "data_boundary": {"$ref": "#/$defs/dataBoundary"}
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["kind", "system"],
      "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["SESSION", "REPOSITORY", "HUMAN"]},
        "system": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
        "repository": {
          "type": ["string", "null"],
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "commit": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{40}$"
        },
        "artifact_uri": {
          "type": ["string", "null"],
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
        },
        "session_id": {
          "type": ["string", "null"],
          "minLength": 1
        }
      }
    },
    "project": {
      "type": "object",
      "required": ["slug", "title", "creator_id"],
      "additionalProperties": false,
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
        "creator_id": {
          "type": ["string", "null"],
          "minLength": 1
        }
      }
    },
    "intent": {
      "type": "object",
      "required": [
        "purpose",
        "creative_question",
        "intended_use",
        "audience_experience",
        "medium_materials"
      ],
      "additionalProperties": false,
      "properties": {
        "purpose": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
        "creative_question": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
        "intended_use": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
        "audience_experience": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "medium_materials": {
          "type": "array",
          "items": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
          "uniqueItems": true
        }
      }
    },
    "constraints": {
      "type": "object",
      "required": [
        "deadline",
        "budget",
        "publication_scope",
        "allowed_source_scopes",
        "prohibited_actions",
        "technical",
        "physical",
        "rights",
        "safety"
      ],
      "additionalProperties": false,
      "properties": {
        "deadline": {
          "type": ["string", "null"],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "budget": {
          "anyOf": [
            {"type": "null"},
            {
              "type": "object",
              "required": ["amount", "currency"],
              "additionalProperties": false,
              "properties": {
                "amount": {"type": "number", "minimum": 0},
                "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}
              }
            }
          ]
        },
        "publication_scope": {
          "enum": ["PROJECT_INTERNAL", "PUBLIC_CITABLE"]
        },
        "allowed_source_scopes": {
          "type": "array",
          "items": {"enum": ["public", "approved-personal-derived", "external-knowledge"]},
          "uniqueItems": true
        },
        "prohibited_actions": {
          "type": "array",
          "items": {"enum": ["publish", "submit", "send", "purchase", "contract", "delete"]},
          "uniqueItems": true
        },
        "technical": {
          "type": "array",
          "items": {"$ref": "common.schema.json#/$defs/nonEmptyString"}
        },
        "physical": {
          "type": "array",
          "items": {"$ref": "common.schema.json#/$defs/nonEmptyString"}
        },
        "rights": {
          "type": "array",
          "items": {"$ref": "common.schema.json#/$defs/nonEmptyString"}
        },
        "safety": {
          "type": "array",
          "items": {"$ref": "common.schema.json#/$defs/nonEmptyString"}
        }
      }
    },
    "reference": {
      "type": "object",
      "required": ["label", "uri", "rights_status"],
      "additionalProperties": false,
      "properties": {
        "label": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
        "uri": {"$ref": "common.schema.json#/$defs/uri"},
        "rights_status": {"enum": ["PUBLIC_CITABLE", "APPROVED_REFERENCE", "UNKNOWN"]}
      }
    },
    "dataBoundary": {
      "type": "object",
      "required": ["classification", "raw_data_included"],
      "additionalProperties": false,
      "properties": {
        "classification": {"enum": ["PRIVATE_DERIVED", "PROJECT_INTERNAL", "PUBLIC_CITABLE"]},
        "raw_data_included": {"const": false}
      }
    }
  }
}
