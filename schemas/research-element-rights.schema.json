{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agentic-art-research/research-element-rights.schema.json",
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "rights_status",
      "redistribution",
      "sensitivity"
    ],
    "properties": {
      "rights_status": {
        "type": "string",
        "minLength": 1
      },
      "redistribution": {
        "enum": [
          "allowed",
          "conditional",
          "prohibited",
          "unknown"
        ]
      },
      "sensitivity": {
        "const": "PUBLIC_CITABLE"
      }
    }
  },
  "required": [],
  "properties": {},
  "propertyNames": {
    "type": "string",
    "pattern": "^https?://"
  }
}
