{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agentic-art-research/research-plan.schema.json",
  "title": "Research plan",
  "type": "object",
  "required": [
    "version",
    "project_id",
    "objective",
    "required_outputs",
    "budget",
    "stopping_policy",
    "source_priority",
    "status",
    "tasks"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "project_id": {
      "$ref": "common.schema.json#/$defs/projectId"
    },
    "objective": {
      "type": [
        "string",
        "null"
      ]
    },
    "required_outputs": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/nonEmptyString"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "budget": {
      "type": "object",
      "required": [
        "max_questions",
        "max_total_sources",
        "max_runtime_minutes"
      ],
      "additionalProperties": false,
      "properties": {
        "max_questions": {
          "type": "integer",
          "minimum": 1
        },
        "max_total_sources": {
          "type": "integer",
          "minimum": 1
        },
        "max_runtime_minutes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "stopping_policy": {
      "$ref": "common.schema.json#/$defs/nonEmptyString"
    },
    "source_priority": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/nonEmptyString"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "status": {
      "$ref": "common.schema.json#/$defs/projectStatus"
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "depends_on"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/nonEmptyString"
          },
          "title": {
            "$ref": "common.schema.json#/$defs/nonEmptyString"
          },
          "depends_on": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/nonEmptyString"
            },
            "uniqueItems": true
          },
          "role": {
            "$ref": "common.schema.json#/$defs/nonEmptyString",
            "$comment": "\u8ab0\u304c\u3053\u306e\u30bf\u30b9\u30af\u3092\u5b9f\u884c\u3059\u308b\u304b\u3002config/task-roles.yaml \u306e roles \u306e\u30ad\u30fc\u3002\u5ba3\u8a00\u304c\u7121\u3044\u30bf\u30b9\u30af\u306f\u540c\u30d5\u30a1\u30a4\u30eb\u306e\u5bfe\u5fdc\u8868\u3067\u89e3\u6c7a\u3059\u308b\u3002"
          }
        }
      }
    },
    "minimums": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "type": "integer",
          "minimum": 0
        },
        "claims": {
          "type": "integer",
          "minimum": 0
        },
        "insights": {
          "type": "integer",
          "minimum": 0
        },
        "decisions": {
          "type": "integer",
          "minimum": 0
        },
        "requirements": {
          "type": "integer",
          "minimum": 0
        },
        "reason": {
          "$ref": "common.schema.json#/$defs/nonEmptyString"
        }
      }
    },
    "element_research": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "question_count": {
          "type": "integer",
          "minimum": 1
        },
        "options_per_decision": {
          "type": "integer",
          "minimum": 2
        },
        "search_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        }
      }
    }
  }
}
