{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agentic-art-research/claim.schema.json",
  "title": "Claim",
  "type": "object",
  "required": ["id", "statement", "type", "evidence_ids", "opposing_claims", "scope", "epistemic_status"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^CL[0-9]{3,}$"},
    "statement": {"type": "string", "minLength": 1},
    "type": {"enum": ["FACT", "SOURCE_CLAIM", "OBSERVATION", "INTERPRETATION", "INFERENCE", "PREFERENCE_SIGNAL", "HYPOTHESIS"]},
    "evidence_ids": {"type": "array", "items": {"type": "string", "pattern": "^EV[0-9]{3,}$"}, "uniqueItems": true},
    "supporting_claims": {"type": "array", "items": {"type": "string", "pattern": "^CL[0-9]{3,}$"}, "uniqueItems": true},
    "opposing_claims": {"type": "array", "items": {"type": "string", "pattern": "^CL[0-9]{3,}$"}, "uniqueItems": true},
    "scope": {"type": "string", "minLength": 1},
    "epistemic_status": {"$ref": "common.schema.json#/$defs/epistemicStatus"},
    "confidence": {
      "type": "object",
      "properties": {
        "source_reliability": {"type": "integer", "minimum": 0, "maximum": 4},
        "directness": {"type": "integer", "minimum": 0, "maximum": 4},
        "corroboration": {"type": "integer", "minimum": 0, "maximum": 4},
        "freshness": {"type": "integer", "minimum": 0, "maximum": 4},
        "scope_fit": {"type": "integer", "minimum": 0, "maximum": 4},
        "conflict_penalty": {"type": "integer", "minimum": 0, "maximum": 2},
        "derived_score": {"type": "integer", "minimum": 0, "maximum": 100}
      },
      "additionalProperties": false
    },
    "valid_from": {"type": ["string", "null"]},
    "review_after": {"type": ["string", "null"]}
  },
  "allOf": [
    {
      "if": {"properties": {"type": {"const": "FACT"}}},
      "then": {"properties": {"evidence_ids": {"minItems": 1}}}
    }
  ]
}

