{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agentic-art-research/harness-checksums.schema.json",
  "title": "Published harness artifact checksums",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "run_id", "entries", "file_set_sha256"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "project_id": {"$ref": "common.schema.json#/$defs/projectId"},
    "run_id": {"type": "string", "pattern": "^HR[0-9]{3,}$"},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "size_bytes"],
        "properties": {
          "path": {"type": "string", "pattern": "^(research-project|handoff)/.+"},
          "sha256": {"$ref": "common.schema.json#/$defs/sha256"},
          "size_bytes": {"type": "integer", "minimum": 0}
        }
      }
    },
    "file_set_sha256": {"$ref": "common.schema.json#/$defs/sha256"}
  }
}
