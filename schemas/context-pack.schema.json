{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agentic-art-research/context-pack.schema.json",
  "title": "Task-minimal role context pack",
  "type": "object",
  "required": ["version", "project_id", "task", "role", "source_paths", "documents", "records"],
  "additionalProperties": false,
  "properties": {
    "version": {"const": 1},
    "project_id": {"$ref": "common.schema.json#/$defs/projectId"},
    "task": {
      "type": "object",
      "required": ["id", "role"],
      "additionalProperties": true,
      "properties": {
        "id": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
        "role": {"$ref": "common.schema.json#/$defs/nonEmptyString"}
      }
    },
    "role": {
      "type": "object",
      "required": ["id", "description", "prohibitions"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
        "description": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
        "prohibitions": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/nonEmptyString"}, "uniqueItems": true}
      }
    },
    "source_paths": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/nonEmptyString"}, "uniqueItems": true},
    "documents": {"type": "object", "additionalProperties": true},
    "records": {
      "type": "object",
      "additionalProperties": {"type": "array", "items": {"type": "object"}}
    }
  }
}
