{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agentic-art-research/decision.schema.json",
  "title": "Decision",
  "type": "object",
  "required": ["id", "question", "selected_option", "rejected_options", "insight_ids", "evidence_ids", "reason", "authority", "status"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^DC[0-9]{3,}$"},
    "question": {"type": "string", "minLength": 1},
    "selected_option": {"type": "string", "minLength": 1},
    "rejected_options": {"type": "array", "items": {"type": "string"}},
    "insight_ids": {"type": "array", "items": {"type": "string", "pattern": "^IN[0-9]{3,}$"}, "uniqueItems": true},
    "evidence_ids": {"type": "array", "items": {"type": "string", "pattern": "^EV[0-9]{3,}$"}, "uniqueItems": true},
    "reason": {"type": "string", "minLength": 1},
    "uncertainty": {"type": ["string", "null"]},
    "review_trigger": {"type": ["string", "null"]},
    "authority": {"enum": ["agent-recommended", "human-approved", "policy-derived"]},
    "status": {"enum": ["PROPOSED", "ADOPTED", "REJECTED", "ON_HOLD", "INVALIDATED"]}
  },
  "anyOf": [
    {"properties": {"insight_ids": {"minItems": 1}}},
    {"properties": {"evidence_ids": {"minItems": 1}}}
  ]
}

