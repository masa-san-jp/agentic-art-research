{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agentic-art-research/decision.schema.json",
  "title": "Decision",
  "type": "object",
  "required": ["id", "question", "selected_option", "rejected_options", "insight_ids", "evidence_ids", "reason", "authority", "status"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^DC[0-9]{3,}$"},
    "question": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
    "selected_option": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
    "rejected_options": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "insight_ids": {
      "type": "array",
      "items": {"type": "string", "pattern": "^IN[0-9]{3,}$"},
      "uniqueItems": true
    },
    "evidence_ids": {
      "type": "array",
      "items": {"type": "string", "pattern": "^EV[0-9]{3,}$"},
      "uniqueItems": true
    },
    "reason": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
    "uncertainty": {"type": ["string", "null"], "minLength": 1},
    "review_trigger": {"type": ["string", "null"], "minLength": 1},
    "authority": {"enum": ["agent-recommended", "human-approved", "policy-derived"]},
    "status": {"$ref": "common.schema.json#/$defs/decisionStatus"}
  },
  "anyOf": [
    {"properties": {"insight_ids": {"minItems": 1}}},
    {"properties": {"evidence_ids": {"minItems": 1}}}
  ]
}
