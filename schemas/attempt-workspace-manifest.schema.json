{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agentic-art-research/attempt-workspace-manifest.schema.json",
  "title": "Task attempt workspace manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "run_id",
    "task_id",
    "attempt_id",
    "role",
    "kind",
    "entries",
    "file_count",
    "total_bytes"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "project_id": {"$ref": "common.schema.json#/$defs/projectId"},
    "run_id": {"type": "string", "pattern": "^HR[0-9]{3,}$"},
    "task_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]{2,}$"},
    "attempt_id": {"type": "string", "pattern": "^AT[A-Za-z0-9_-]{3,}$"},
    "role": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
    "kind": {"enum": ["PROJECT", "PROTECTED_ROOT"]},
    "entries": {
      "type": "array",
      "items": {"$ref": "#/$defs/entry"}
    },
    "file_count": {"type": "integer", "minimum": 0},
    "total_bytes": {"type": "integer", "minimum": 0}
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "type", "mode", "size", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "type": {"enum": ["file", "directory"]},
        "mode": {"type": "integer", "minimum": 0},
        "size": {"type": "integer", "minimum": 0},
        "sha256": {
          "type": ["string", "null"],
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "directory"}}, "required": ["type"]},
          "then": {
            "properties": {
              "size": {"const": 0},
              "sha256": {"type": "null"}
            }
          }
        },
        {
          "if": {"properties": {"type": {"const": "file"}}, "required": ["type"]},
          "then": {
            "properties": {
              "sha256": {"type": "string"}
            }
          }
        }
      ]
    }
  }
}
