{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agentic-art-research/human-decisions.schema.json",
  "title": "Project human decision journal",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "requests", "responses"],
