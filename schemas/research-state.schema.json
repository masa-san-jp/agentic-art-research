{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agentic-art-research/research-state.schema.json",
  "title": "Research project runtime state",
  "type": "object",
  "required": [
    "version",
    "project_id",
    "status",
    "updated_at",
    "current_task",
    "last_event_id",
    "blocked_by",
    "resume_from"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "project_id": {
      "$ref": "common.schema.json#/$defs/projectId"
    },
    "status": {
      "$ref": "common.schema.json#/$defs/projectStatus"
    },
    "updated_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "current_task": {
      "type": [
        "string",
        "null"
      ]
    },
    "last_event_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "blocked_by": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/nonEmptyString"
      }
    },
    "resume_from": {
      "$ref": "common.schema.json#/$defs/nonEmptyString"
    },
    "task_runtime": {
      "type": "object",
      "required": [
        "version",
        "initialized_at",
        "tasks"
      ],
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 1
        },
        "initialized_at": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "tasks": {
          "type": "object",
          "patternProperties": {
            "^[A-Z][A-Z0-9_-]{2,}$": {
              "$ref": "#/$defs/task"
            }
          },
          "additionalProperties": false
        }
      }
    }
  },
  "$defs": {
    "task": {
      "type": "object",
      "required": [
        "depends_on",
        "max_attempts",
        "status",
        "attempts",
        "lease",
        "result",
        "failure",
        "effect_key"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "$ref": "common.schema.json#/$defs/nonEmptyString"
        },
        "depends_on": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/nonEmptyString"
          },
          "uniqueItems": true
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "$ref": "common.schema.json#/$defs/taskStatus"
        },
        "attempts": {
          "type": "integer",
          "minimum": 0
        },
        "lease": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "owner",
            "token",
            "expires_at"
          ],
          "additionalProperties": false,
          "properties": {
            "owner": {
              "$ref": "common.schema.json#/$defs/nonEmptyString"
            },
            "token": {
              "$ref": "common.schema.json#/$defs/nonEmptyString"
            },
            "expires_at": {
              "$ref": "common.schema.json#/$defs/timestamp"
            }
          }
        },
        "result": {},
        "failure": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "class",
            "message",
            "attempt",
            "occurred_at"
          ],
          "additionalProperties": false,
          "properties": {
            "class": {
              "$ref": "common.schema.json#/$defs/taskFailureClass"
            },
            "message": {
              "$ref": "common.schema.json#/$defs/nonEmptyString"
            },
            "attempt": {
              "type": "integer",
              "minimum": 1
            },
            "occurred_at": {
              "$ref": "common.schema.json#/$defs/timestamp"
            }
          }
        },
        "effect_key": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "human_decision_request": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["id", "request_sha256", "category"],
          "properties": {
            "id": {"type": "string", "pattern": "^DR[0-9]{3,}$"},
            "request_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "category": {"$ref": "common.schema.json#/$defs/humanDecisionCategory"}
          }
        },
        "human_decision_response": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["id", "request_id", "request_sha256", "response_sha256", "action", "resolved_at"],
          "properties": {
            "id": {"type": "string", "pattern": "^DRR[0-9]{3,}$"},
            "request_id": {"type": "string", "pattern": "^DR[0-9]{3,}$"},
            "request_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "response_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "action": {"enum": ["APPROVE", "REJECT", "SELECT", "CANCEL"]},
            "selected_option": {"type": ["string", "null"]},
            "resolved_at": {"$ref": "common.schema.json#/$defs/timestamp"}
          }
        },
        "lease_expiries": {
          "type": "integer",
          "minimum": 0,
          "$comment": "lease が切れた回数。作業の失敗ではないので attempts とは別に数える。この欄を持たない既存の state は 0 として扱う。"
        }
      }
    }
  }
}
