{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agentic-art-research/observation.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "statement", "scope", "evidence_ids"],
  "properties": {
    "id": {"type": "string", "pattern": "^OB[0-9]{3,}$"},
    "statement": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
    "scope": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^EV[0-9]{3,}$"}
    }
  }
}
