{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agentic-art-research/retrieved-source.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "url",
    "title",
    "body",
    "acquired_at",
    "content_hash",
    "id",
    "duplicate_of",
    "rights_status",
    "redistribution",
    "sensitivity"
  ],
  "properties": {
    "url": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "body": {
      "type": "string",
      "minLength": 1
    },
    "acquired_at": {
      "type": "string",
      "format": "date-time"
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "id": {
      "type": "string",
      "pattern": "^SRC[0-9]{3,}$"
    },
    "duplicate_of": {
      "type": [
        "string",
        "null"
      ]
    },
    "rights_status": {
      "type": "string",
      "minLength": 1
    },
    "redistribution": {
      "enum": [
        "allowed",
        "conditional",
        "prohibited",
        "unknown"
      ]
    },
    "sensitivity": {
      "const": "PUBLIC_CITABLE"
    }
  }
}
