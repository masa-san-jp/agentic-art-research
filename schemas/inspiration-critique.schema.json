{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agentic-art-research/inspiration-critique.schema.json",
  "title": "Inspiration candidate critique",
  "type": "object",
  "required": ["id", "candidate_id", "candidate_revision", "findings", "status"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^ICT[0-9]{3,}$"},
    "candidate_id": {"type": "string", "pattern": "^IC[0-9]{3,}$"},
    "candidate_revision": {"type": "integer", "minimum": 1},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "severity", "field", "statement", "required_action"],
        "additionalProperties": false,
        "properties": {
          "code": {"enum": ["POETIC_ONLY", "MEASUREMENT_ONLY", "MATERIAL_DISCONNECTED", "INCOMPLETE_PATH", "SOURCE_UNSAFE"]},
          "severity": {"enum": ["MAJOR", "MINOR"]},
          "field": {"type": "string", "minLength": 1},
          "statement": {"type": "string", "minLength": 1},
          "required_action": {"type": "string", "minLength": 1}
        }
      }
    },
    "status": {"enum": ["PASS", "REVISION_REQUIRED"]}
  }
}
