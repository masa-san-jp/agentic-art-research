{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agentic-art-research/project-manifest.schema.json",
  "title": "Research project manifest",
  "type": "object",
  "required": ["project", "entry_points", "access"],
  "additionalProperties": false,
  "properties": {
    "project": {
      "type": "object",
      "required": ["id", "title", "version", "status", "created_at", "updated_at"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "common.schema.json#/$defs/projectId"},
        "title": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
        },
        "status": {"$ref": "common.schema.json#/$defs/projectStatus"},
        "creator_id": {"type": ["string", "null"], "minLength": 1},
        "created_at": {"$ref": "common.schema.json#/$defs/timestamp"},
        "updated_at": {"$ref": "common.schema.json#/$defs/timestamp"}
      }
    },
    "entry_points": {
      "type": "object",
      "required": ["human_summary", "research_plan", "evidence_ledger", "decision_log", "production_requirements", "completion_report"],
      "additionalProperties": false,
      "properties": {
        "human_summary": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
        "research_plan": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
        "evidence_ledger": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
        "decision_log": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
        "production_requirements": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
        "completion_report": {"$ref": "common.schema.json#/$defs/nonEmptyString"}
      }
    },
    "access": {
      "type": "object",
      "required": ["classification"],
      "additionalProperties": false,
      "properties": {
        "classification": {"$ref": "common.schema.json#/$defs/accessClass"},
        "allowed_agents": {
          "type": "array",
          "items": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
          "uniqueItems": true
        }
      }
    }
  }
}
