{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agentic-art-research/project-manifest.schema.json",
  "title": "Research project manifest",
  "type": "object",
  "required": ["project", "entry_points", "access"],
  "additionalProperties": false,
  "properties": {
    "workflow_mode": {"$ref": "common.schema.json#/$defs/workflowMode"},
    "project": {
      "type": "object",
      "required": ["id", "title", "version", "status", "created_at", "updated_at"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "common.schema.json#/$defs/projectId"},
        "title": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
        "version": {"$ref": "common.schema.json#/$defs/semver"},
        "status": {"$ref": "common.schema.json#/$defs/projectStatus"},
        "creator_id": {"type": ["string", "null"], "minLength": 1},
        "created_at": {"$ref": "common.schema.json#/$defs/timestamp"},
        "updated_at": {"$ref": "common.schema.json#/$defs/timestamp"}
      }
    },
    "entry_points": {
      "type": "object",
      "required": ["human_summary", "research_plan", "evidence_ledger", "decision_log", "production_requirements", "completion_report"],
      "additionalProperties": false,
      "properties": {
        "human_summary": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
        "research_plan": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
        "evidence_ledger": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
        "decision_log": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
        "production_requirements": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
        "production_hypotheses": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
        "hypothesis_comparison": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
        "prototype_plans": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
        "production_handoff": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
        "production_change_requests": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
        "production_feedback_imports": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
        "research_request": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
        "research_request_receipt": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
        "completion_report": {"$ref": "common.schema.json#/$defs/nonEmptyString"}
      }
    },
    "access": {
      "type": "object",
      "required": ["classification"],
      "additionalProperties": false,
      "properties": {
        "classification": {"$ref": "common.schema.json#/$defs/accessClass"},
        "allowed_agents": {
          "type": "array",
          "items": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
          "uniqueItems": true
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["workflow_mode"],
        "properties": {"workflow_mode": {"const": "PRODUCTION_HANDOFF"}}
      },
      "then": {
        "properties": {
          "entry_points": {
            "required": [
              "production_hypotheses",
              "hypothesis_comparison",
              "prototype_plans",
              "production_handoff",
              "production_change_requests",
              "production_feedback_imports"
            ]
          }
        }
      }
    }
  ]
}
