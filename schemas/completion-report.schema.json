{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agentic-art-research/completion-report.schema.json",
  "title": "Completion report",
  "type": "object",
  "required": [
    "project_id",
    "status",
    "completed_at",
    "checks",
    "gaps",
    "blockers",
    "reopen_triggers"
  ],
  "additionalProperties": false,
  "properties": {
    "project_id": {
      "$ref": "common.schema.json#/$defs/projectId"
    },
    "status": {
      "enum": [
        "COMPLETE",
        "COMPLETE_WITH_GAPS",
        "INCOMPLETE",
        "BLOCKED",
        "CANCELLED"
      ]
    },
    "completed_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "checks": {
      "type": "object",
      "required": [
        "manifest_valid",
        "mandatory_questions_terminal",
        "evidence_ledger_valid",
        "claim_references_resolved",
        "decisions_traceable",
        "requirements_testable",
        "rights_review_complete",
        "privacy_review_complete",
        "no_private_raw_in_git",
        "completion_report_terminal"
      ],
      "additionalProperties": false,
      "properties": {
        "manifest_valid": {
          "type": "boolean"
        },
        "mandatory_questions_terminal": {
          "type": "boolean"
        },
        "evidence_ledger_valid": {
          "type": "boolean"
        },
        "claim_references_resolved": {
          "type": "boolean"
        },
        "decisions_traceable": {
          "type": "boolean"
        },
        "requirements_testable": {
          "type": "boolean"
        },
        "rights_review_complete": {
          "type": "boolean"
        },
        "privacy_review_complete": {
          "type": "boolean"
        },
        "no_private_raw_in_git": {
          "type": "boolean"
        },
        "completion_report_terminal": {
          "type": "boolean"
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "reason",
          "impact"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/nonEmptyString"
          },
          "reason": {
            "$ref": "common.schema.json#/$defs/nonEmptyString"
          },
          "impact": {
            "$ref": "common.schema.json#/$defs/nonEmptyString"
          }
        }
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "reason",
          "release_condition"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/nonEmptyString"
          },
          "reason": {
            "$ref": "common.schema.json#/$defs/nonEmptyString"
          },
          "release_condition": {
            "$ref": "common.schema.json#/$defs/nonEmptyString"
          }
        }
      }
    },
    "reopen_triggers": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/nonEmptyString"
      },
      "uniqueItems": true
    },
    "volume": {
      "type": "object",
      "$comment": "何件あって、何件必要で、どこが足りないか。読めば「調べていない」が一目で分かる。",
      "required": [
        "counts",
        "minimums",
        "shortfall",
        "unexplained_overrides"
      ],
      "additionalProperties": false,
      "properties": {
        "counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "minimums": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "shortfall": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "required",
              "actual"
            ],
            "additionalProperties": false,
            "properties": {
              "required": {
                "type": "integer"
              },
              "actual": {
                "type": "integer"
              }
            }
          }
        },
        "unexplained_overrides": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    }
  }
}
