{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agentic-art-research/human-decision-request.schema.json",
  "title": "Human decision request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "project_id", "run_id", "task_id", "attempt_id",
    "human_decision_category", "question", "facts", "options", "recommended_option",
    "impact", "default_safe_action", "source_refs", "request_sha256", "created_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "id": {"type": "string", "pattern": "^DR[0-9]{3,}$"},
    "project_id": {"$ref": "common.schema.json#/$defs/projectId"},
    "run_id": {"type": "string", "pattern": "^HR[0-9]{3,}$"},
    "task_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]{2,}$"},
    "attempt_id": {"type": "string", "pattern": "^AT[A-Za-z0-9_-]{3,}$"},
    "human_decision_category": {"$ref": "common.schema.json#/$defs/humanDecisionCategory"},
    "question": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
    "facts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/fact"},
      "uniqueItems": true
    },
    "options": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/option"},
      "uniqueItems": true
    },
    "recommended_option": {"type": ["string", "null"]},
    "impact": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
    "default_safe_action": {
      "enum": ["DEFER", "REJECT", "CANCEL", "KEEP_CURRENT_SCOPE", "COMPLETE_WITH_GAPS"]
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
      "uniqueItems": true
    },
    "request_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "created_at": {"$ref": "common.schema.json#/$defs/timestamp"}
  },
  "$defs": {
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement"],
      "properties": {
        "id": {"type": "string", "pattern": "^F[0-9]{3,}$"},
        "statement": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
        "source_refs": {
          "type": "array",
          "items": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
          "uniqueItems": true
        }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "consequence"],
      "properties": {
        "id": {"type": "string", "pattern": "^OPT-[A-Za-z0-9_-]+$"},
        "label": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
        "consequence": {"$ref": "common.schema.json#/$defs/nonEmptyString"}
      }
    }
  }
}
