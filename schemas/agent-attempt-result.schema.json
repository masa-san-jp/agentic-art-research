{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agentic-art-research/agent-attempt-result.schema.json",
  "title": "Agent attempt result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "attempt_id",
    "status",
    "summary",
    "effect_key",
    "outputs",
    "failure",
    "human_decision_request",
    "diagnostics"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "run_id": {"type": "string", "pattern": "^HR[0-9]{3,}$"},
    "attempt_id": {"type": "string", "pattern": "^AT[A-Za-z0-9_-]{3,}$"},
    "status": {"enum": ["SUCCEEDED", "FAILED", "HUMAN_REQUIRED"]},
    "summary": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
    "effect_key": {
      "type": ["string", "null"],
      "pattern": "^[A-Za-z0-9._:/-]+$"
    },
    "outputs": {
      "type": "array",
      "items": {"$ref": "#/$defs/output"}
    },
    "failure": {
      "anyOf": [
        {"type": "null"},
        {"$ref": "#/$defs/failure"}
      ]
    },
    "human_decision_request": {
      "anyOf": [
        {"type": "null"},
        {"$ref": "#/$defs/humanDecisionRequest"}
      ]
    },
    "diagnostics": {"$ref": "#/$defs/diagnostics"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "SUCCEEDED"}}, "required": ["status"]},
      "then": {
        "properties": {
          "effect_key": {"type": "string"},
          "failure": {"type": "null"},
          "human_decision_request": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "FAILED"}}, "required": ["status"]},
      "then": {
        "properties": {
          "effect_key": {"type": "null"},
          "failure": {"$ref": "#/$defs/failure"},
          "human_decision_request": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "HUMAN_REQUIRED"}}, "required": ["status"]},
      "then": {
        "properties": {
          "effect_key": {"type": "null"},
          "failure": {"type": "null"},
          "human_decision_request": {"$ref": "#/$defs/humanDecisionRequest"}
        }
      }
    }
  ],
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "value"],
      "properties": {
        "id": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
        "kind": {"enum": ["ARTIFACT", "PATCH", "REPORT", "REFERENCE", "TEXT", "JSON"]},
        "path": {"$ref": "#/$defs/relativePath"},
        "value": {}
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "message"],
      "properties": {
        "class": {
          "enum": [
            "WORKER-COMMAND",
            "WORKER-TIMEOUT",
            "WORKER-EXIT",
            "WORKER-PROTOCOL",
            "WORKER-OUTPUT-LIMIT",
            "WORKER-SECRET-OUTPUT",
            "WORKER-CAPABILITY"
          ]
        },
        "message": {"$ref": "common.schema.json#/$defs/nonEmptyString"}
      }
    },
    "humanDecisionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "question", "options"],
      "properties": {
        "id": {"type": "string", "pattern": "^DR[0-9]{3,}$"},
        "question": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
        "options": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
          "uniqueItems": true
        }
      }
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stderr", "exit_code", "signal", "timed_out"],
      "properties": {
        "stderr": {"type": "string", "maxLength": 16384},
        "exit_code": {"type": ["integer", "null"]},
        "signal": {"type": ["integer", "null"], "minimum": 1},
        "timed_out": {"type": "boolean"},
        "stream": {"enum": ["stdout", "stderr"]},
        "bytes": {"type": "integer", "minimum": 0}
      }
    }
  }
}
