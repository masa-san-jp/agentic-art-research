{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agentic-art-research/search-attempt-request.schema.json",
  "title": "Typed search attempt request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "project_id",
    "run_id",
    "task_id",
    "attempt_id",
    "question_id",
    "strategy_id",
    "query",
    "adapter"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "request_id": {"type": "string", "pattern": "^SR[A-Za-z0-9_-]{3,}$"},
    "project_id": {"$ref": "common.schema.json#/$defs/projectId"},
    "run_id": {"type": "string", "pattern": "^HR[0-9]{3,}$"},
    "task_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]{2,}$"},
    "attempt_id": {"type": "string", "pattern": "^AT[A-Za-z0-9_-]{3,}$"},
    "question_id": {"type": "string", "pattern": "^Q[0-9]{3,}$"},
    "strategy_id": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
    "query": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
    "adapter": {"enum": ["fake"]}
  }
}
