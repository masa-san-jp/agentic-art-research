{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agentic-art-research/acceptance-report.schema.json",
  "title": "Typed acceptance report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_id",
    "project_id",
    "run_id",
    "task_id",
    "attempt_id",
    "evaluated_at",
    "status",
    "gates"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "report_id": {"type": "string", "pattern": "^AR-[0-9a-f]{16}$"},
    "project_id": {"$ref": "common.schema.json#/$defs/projectId"},
    "run_id": {"type": "string", "pattern": "^HR[0-9]{3,}$"},
    "task_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]{2,}$"},
    "attempt_id": {"type": "string", "pattern": "^AT[A-Za-z0-9_-]{3,}$"},
    "evaluated_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "status": {"enum": ["PASS", "FAIL"]},
    "gates": {
      "type": "array",
      "items": {"$ref": "#/$defs/gate"}
    }
  },
  "$defs": {
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "status", "path", "expected", "actual", "rule", "remediation", "duration_ms"],
      "properties": {
        "id": {"type": "string", "pattern": "^AG-[A-Z0-9-]+$"},
        "kind": {
          "enum": [
            "repository_validate",
            "project_validate",
            "collection_minimum",
            "run_event_minimum",
            "stopping_evaluate",
            "hypothesis_selection",
            "medium_decision",
            "graph_current",
            "completion_status"
          ]
        },
        "status": {"enum": ["PASS", "FAIL"]},
        "path": {"type": ["string", "null"]},
        "expected": {},
        "actual": {},
        "rule": {"type": ["string", "null"], "pattern": "^[A-Z][A-Z0-9_-]*$"},
        "remediation": {"type": ["string", "null"]},
        "duration_ms": {"const": 0}
      }
    }
  }
}
