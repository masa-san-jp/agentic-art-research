{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agentic-art-research/cumulative-specificity-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "rule_version",
    "creator_id",
    "origin_instance_id",
    "at",
    "seed",
    "project_snapshot",
    "inputs",
    "sources",
    "candidates",
    "memory_query"
  ],
  "properties": {
    "contract_version": {
      "const": "cumulative-specificity-request/v1"
    },
    "rule_version": {
      "type": "string",
      "minLength": 1
    },
    "creator_id": {
      "type": "string",
      "minLength": 1
    },
    "origin_instance_id": {
      "type": "string",
      "minLength": 1
    },
    "at": {
      "type": "string",
      "minLength": 1
    },
    "seed": {
      "type": "integer"
    },
    "project_snapshot": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "memory_query": {
      "type": [
        "object",
        "null"
      ]
    }
  }
}
