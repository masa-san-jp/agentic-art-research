{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agentic-art-research/research-elements-config.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "max_attempts",
    "question_count",
    "options_per_decision",
    "search_limit",
    "input_bytes",
    "body_chunk_bytes",
    "max_search_body_bytes",
    "max_search_answer_bytes",
    "insight_group_size",
    "search_strategies",
    "forbidden",
    "pair_relations",
    "rights_default",
    "rights_by_url",
    "paths",
    "default_route",
    "max_claim_pairs",
    "derivation_similarity_threshold",
    "search_strategy_descriptions"
  ],
  "properties": {
    "version": {
      "const": 2
    },
    "max_attempts": {
      "type": "integer",
      "minimum": 1
    },
    "question_count": {
      "type": "integer",
      "minimum": 1
    },
    "options_per_decision": {
      "type": "integer",
      "minimum": 2,
      "maximum": 5
    },
    "search_limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "input_bytes": {
      "type": "integer",
      "minimum": 256,
      "maximum": 4096
    },
    "body_chunk_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "max_search_body_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "max_search_answer_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "insight_group_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2
    },
    "search_strategies": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "forbidden": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "pair_relations": {
      "const": [
        "supports",
        "opposes",
        "unrelated"
      ]
    },
    "rights_default": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rights_status",
        "redistribution",
        "sensitivity"
      ],
      "properties": {
        "rights_status": {
          "type": "string",
          "minLength": 1
        },
        "redistribution": {
          "enum": [
            "allowed",
            "conditional",
            "prohibited",
            "unknown"
          ]
        },
        "sensitivity": {
          "const": "PUBLIC_CITABLE"
        }
      }
    },
    "rights_by_url": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^https?://"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rights_status",
          "redistribution",
          "sensitivity"
        ],
        "properties": {
          "rights_status": {
            "type": "string",
            "minLength": 1
          },
          "redistribution": {
            "enum": [
              "allowed",
              "conditional",
              "prohibited",
              "unknown"
            ]
          },
          "sensitivity": {
            "const": "PUBLIC_CITABLE"
          }
        }
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "lock",
        "questions",
        "sources",
        "evidence",
        "observations",
        "claims",
        "relationships",
        "contradictions",
        "insights",
        "decisions",
        "rejected",
        "prior_art",
        "rights",
        "log",
        "excerpts",
        "uncertainties",
        "reviews",
        "repetition_report"
      ],
      "properties": {
        "state": {
          "const": "07_runtime/research-elements.json"
        },
        "lock": {
          "const": "07_runtime/research-elements.lock"
        },
        "questions": {
          "const": "01_planning/question-register.yaml"
        },
        "sources": {
          "const": "02_evidence/source-ledger.jsonl"
        },
        "evidence": {
          "const": "02_evidence/evidence-ledger.jsonl"
        },
        "observations": {
          "const": "03_knowledge/observations.jsonl"
        },
        "claims": {
          "const": "03_knowledge/claims.jsonl"
        },
        "relationships": {
          "const": "03_knowledge/relationships.jsonl"
        },
        "contradictions": {
          "const": "03_knowledge/contradictions.jsonl"
        },
        "insights": {
          "const": "04_decisions/insight-register.yaml"
        },
        "decisions": {
          "const": "04_decisions/decision-log.yaml"
        },
        "rejected": {
          "const": "04_decisions/rejected-options.yaml"
        },
        "prior_art": {
          "const": "03_knowledge/prior-art.jsonl"
        },
        "rights": {
          "const": "06_governance/rights-register.yaml"
        },
        "log": {
          "const": "07_runtime/run-log.jsonl"
        },
        "excerpts": {
          "const": "02_evidence/excerpts.jsonl"
        },
        "uncertainties": {
          "const": "04_decisions/uncertainty-register.yaml"
        },
        "reviews": {
          "const": "04_decisions/self-repetition-review.yaml"
        },
        "repetition_report": {
          "const": "07_runtime/element-repetition-scan.json"
        }
      }
    },
    "default_route": {
      "const": "research_elements"
    },
    "max_claim_pairs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "derivation_similarity_threshold": {
      "type": "string",
      "const": "0.9"
    },
    "search_strategy_descriptions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary",
        "counterexample",
        "independent-secondary"
      ],
      "properties": {
        "primary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "counterexample": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "independent-secondary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      }
    }
  }
}
