{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agentic-art-research/harness-event.schema.json",
  "title": "Agent harness observable event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "event_id", "seq", "run_id", "project_id", "phase",
    "event_type", "occurred_at", "hashes", "previous_event_sha256", "event_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "event_id": {"type": "string", "pattern": "^HE[0-9a-f]{16}$"},
    "seq": {"type": "integer", "minimum": 1},
    "run_id": {"type": "string", "pattern": "^HR[0-9]{3,}$"},
    "project_id": {"$ref": "common.schema.json#/$defs/projectId"},
    "task_id": {"type": ["string", "null"], "pattern": "^[A-Z][A-Z0-9_-]{2,}$"},
    "attempt_id": {"type": ["string", "null"], "pattern": "^AT[A-Za-z0-9_-]{3,}$"},
    "phase": {"enum": ["PREFLIGHT", "BOOTSTRAPPED", "RUNNING", "COMPLETING", "BUILDING_HANDOFF", "EXPORTING", "PUBLISHING", "COMPLETE"]},
    "event_type": {"enum": ["RUN_STARTED", "PHASE_ENTERED", "TASK_CLAIMED", "ATTEMPT_PREPARED", "WORKER_STARTED", "WORKER_RESULT", "HEARTBEAT", "RETRY_SCHEDULED", "ACCEPTANCE", "TASK_PROMOTED", "TASK_COMPLETED", "HUMAN_WAIT", "HANDOFF_BUILT", "OUTPUT_PUBLISHED", "RUN_PAUSED", "RUN_FAILED", "RUN_TERMINAL"]},
    "occurred_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "status": {"type": ["string", "null"], "enum": ["RUNNING", "COMPLETE", "ALREADY_PUBLISHED", "PAUSED", "FAILED", "BLOCKED", "NO_TASK_READY", null]},
    "failure_class": {"type": ["string", "null"], "pattern": "^[A-Z][A-Z0-9_-]+$"},
    "hashes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "worker_fingerprint": {"$ref": "common.schema.json#/$defs/sha256"},
        "attempt_request_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "result_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "changeset_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "acceptance_report_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "handoff_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "output_sha256": {"$ref": "common.schema.json#/$defs/sha256"}
      }
    },
    "previous_event_sha256": {"anyOf": [{"$ref": "common.schema.json#/$defs/sha256"}, {"type": "null"}]},
    "event_sha256": {"$ref": "common.schema.json#/$defs/sha256"}
  }
}
