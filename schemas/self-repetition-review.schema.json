{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agentic-art-research/self-repetition-review.schema.json",
  "title": "Self repetition review",
  "$comment": "仕様書 §8.1 は既視感・自己反復リスクを出力に挙げているが、記録する場所も検査も無かった。",
  "type": "object",
  "required": ["reviewed_at", "reviewed_by", "past_works_considered", "risk", "reason"],
  "additionalProperties": false,
  "properties": {
    "reviewed_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "reviewed_by": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
    "past_works_considered": {
      "type": "array",
      "minItems": 1,
      "$comment": "1件も見ずに「反復していない」とは言えない。",
      "items": {
        "type": "object",
        "required": ["title", "distance"],
        "additionalProperties": false,
        "properties": {
          "title": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
          "source_location": {"anyOf": [{"$ref": "common.schema.json#/$defs/uri"}, {"type": "null"}]},
          "distance": {
            "enum": ["NEAR_REPETITION", "SAME_LINEAGE", "DISTANT", "UNRELATED"],
            "$comment": "NEAR_REPETITION を1件でも含むなら mitigation を書く。"
          },
          "note": {"type": ["string", "null"], "minLength": 1}
        }
      }
    },
    "risk": {"enum": ["LOW", "MEDIUM", "HIGH"]},
    "reason": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
    "mitigation": {"type": ["string", "null"], "minLength": 1}
  },
  "allOf": [
    {
      "$comment": "近い反復を認めたなら、どう離すかを書かないと評価が完了しない。",
      "if": {
        "properties": {
          "past_works_considered": {
            "contains": {"properties": {"distance": {"const": "NEAR_REPETITION"}}, "required": ["distance"]}
          }
        },
        "required": ["past_works_considered"]
      },
      "then": {"required": ["mitigation"], "properties": {"mitigation": {"type": "string", "minLength": 1}}}
    }
  ]
}
