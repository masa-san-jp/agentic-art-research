{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agentic-art-research/retry-feedback.schema.json",
  "title": "Deterministic retry feedback bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "feedback_id", "project_id", "run_id", "task_id", "source_attempt_id", "report_id", "report_sha256", "findings"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "feedback_id": {"type": "string", "pattern": "^RF-[0-9a-f]{16}$"},
    "project_id": {"$ref": "common.schema.json#/$defs/projectId"},
    "run_id": {"type": "string", "pattern": "^HR[0-9]{3,}$"},
    "task_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]{2,}$"},
    "source_attempt_id": {"type": "string", "pattern": "^AT[A-Za-z0-9_-]{3,}$"},
    "report_id": {"type": "string", "pattern": "^AR-[0-9a-f]{16}$"},
    "report_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "findings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {"$ref": "#/$defs/finding"}
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_id", "kind", "path", "rule", "remediation", "finding"],
      "properties": {
        "gate_id": {"type": "string", "pattern": "^AG-[A-Z0-9-]+$"},
        "kind": {"type": "string", "minLength": 1},
        "path": {"type": ["string", "null"]},
        "rule": {"type": ["string", "null"], "pattern": "^[A-Z][A-Z0-9_-]*$"},
        "remediation": {"type": ["string", "null"]},
        "finding": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    }
  }
}
