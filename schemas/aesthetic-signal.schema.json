{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agentic-art-research/aesthetic-signal.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "creator_id", "statement", "evidence_refs", "observed_period", "strength", "context", "counterexample_refs", "confidence_status", "review_after"],
  "properties": {
    "id": {"type": "string", "pattern": "^AS[0-9]{3,}$"},
    "creator_id": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9]|-(?=[a-z0-9])){1,62}[a-z0-9]$"},
    "statement": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^project/[a-z0-9]+(?:-[a-z0-9]+)*::EV[0-9]{3,}$"}
    },
    "observed_period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": {"$ref": "common.schema.json#/$defs/date"},
        "to": {"$ref": "common.schema.json#/$defs/date"}
      }
    },
    "strength": {"$ref": "common.schema.json#/$defs/aestheticSignalStrength"},
    "context": {"$ref": "common.schema.json#/$defs/aestheticSignalContext"},
    "counterexample_refs": {
      "type": "array",
      "items": {"type": "string", "pattern": "^project/[a-z0-9]+(?:-[a-z0-9]+)*::EV[0-9]{3,}$"}
    },
    "confidence_status": {"$ref": "common.schema.json#/$defs/epistemicStatus"},
    "review_after": {"$ref": "common.schema.json#/$defs/date"}
  }
}
